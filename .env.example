# Android App Config
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# DropZero Backend Config
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://dropzero:dropzero@localhost:5432/dropzero

# Redis
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# App Config Defaults
MIN_APP_VERSION=1.0.0
FEATURE_REWARDS_ENABLED=true
